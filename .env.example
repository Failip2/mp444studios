# Copy to .env and fill in. Never commit .env — it is gitignored.

# Canonical origin. Used for OG tags, sitemap.xml and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://mp444studios.com

# --- Contact form (SMTP) -----------------------------------------------------
# Without these the contact page still renders and still shows the email address
# and phone number; only the form's send step reports that it is not configured.
#
# For Gmail you must use an App Password, not the account password:
#   1. Enable 2-Step Verification on the Google account.
#   2. https://myaccount.google.com/apppasswords -> create one for "Mail".
#   3. Paste the 16 characters below (spaces are fine to remove).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=filip.raeburn@gmail.com
SMTP_PASS=

# Where enquiries are delivered. Defaults to SMTP_USER if unset.
CONTACT_TO=filip.raeburn@gmail.com
